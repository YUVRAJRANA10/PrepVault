generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model DailyStats {
  id               Int      @id @default(autoincrement())
  day              DateTime @unique
  totalExperiences Int
  totalUsers       Int
  createdAt        DateTime @default(now())
}
